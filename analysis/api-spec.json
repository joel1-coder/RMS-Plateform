[
  {
    "endpoint": "POST /api/auth/login",
    "description": "Authenticates user and returns JWT token plus user profile data.",
    "auth": "None",
    "request": {
      "email": "string (required, valid email)",
      "password": "string (required, min 6 chars)",
      "role": "string (required, one of: admin, supervisor, scholar, hod, drc, librarian)"
    },
    "response": {
      "token": "JWT token string",
      "user": {
        "id": "number/ObjectId",
        "email": "string",
        "name": "string",
        "role": "string",
        "dept": "string"
      }
    },
    "status_codes": {
      "200": "Successful authentication",
      "400": "Validation error or missing fields",
      "401": "Invalid email, password, or role mismatched"
    }
  },
  {
    "endpoint": "GET /api/users",
    "description": "Returns list of all users, filterable by role and status.",
    "auth": "Bearer JWT (admin, hod)",
    "request_params": {
      "role": "string (optional)",
      "status": "string (optional)"
    },
    "response": [
      {
        "id": "number/ObjectId",
        "name": "string",
        "email": "string",
        "role": "string",
        "dept": "string",
        "status": "string",
        "joined": "string (YYYY-MM-DD)",
        "assignedSupervisor": "string (optional)",
        "assignedSupervisorId": "number/ObjectId (optional)"
      }
    ],
    "status_codes": {
      "200": "Success",
      "403": "Access Denied"
    }
  },
  {
    "endpoint": "POST /api/users",
    "description": "Creates a new system user.",
    "auth": "Bearer JWT (admin)",
    "request": {
      "name": "string (required)",
      "email": "string (required, valid email)",
      "password": "string (required)",
      "role": "string (required, admin/supervisor/scholar/hod/drc/librarian)",
      "dept": "string (required)",
      "status": "string (optional, default: Active)"
    },
    "response": {
      "id": "number/ObjectId",
      "name": "string",
      "email": "string",
      "role": "string",
      "dept": "string",
      "status": "string"
    },
    "status_codes": {
      "201": "Created",
      "400": "Validation failed / Email already exists"
    }
  },
  {
    "endpoint": "PUT /api/users/:id",
    "description": "Updates details of an existing user.",
    "auth": "Bearer JWT (admin)",
    "request": {
      "name": "string (optional)",
      "email": "string (optional)",
      "password": "string (optional)",
      "role": "string (optional)",
      "dept": "string (optional)",
      "status": "string (optional)"
    },
    "response": {
      "id": "number/ObjectId",
      "name": "string",
      "email": "string",
      "role": "string",
      "dept": "string",
      "status": "string"
    },
    "status_codes": {
      "200": "Updated successfully",
      "404": "User not found"
    }
  },
  {
    "endpoint": "DELETE /api/users/:id",
    "description": "Deletes a user from the system.",
    "auth": "Bearer JWT (admin)",
    "response": {
      "success": "boolean"
    },
    "status_codes": {
      "200": "Deleted successfully",
      "404": "User not found"
    }
  },
  {
    "endpoint": "PUT /api/users/:scholarId/assign-supervisor",
    "description": "Assigns a supervisor to a scholar candidate.",
    "auth": "Bearer JWT (admin, hod)",
    "request": {
      "supervisorId": "number/ObjectId (required)"
    },
    "response": {
      "id": "number/ObjectId",
      "name": "string",
      "role": "Scholar",
      "assignedSupervisor": "string",
      "assignedSupervisorId": "number/ObjectId"
    },
