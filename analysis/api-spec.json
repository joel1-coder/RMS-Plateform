      "role": "string (optional)",
      "dept": "string (optional)",
      "status": "string (optional)"
    },
    "response": {
      "id": "number/ObjectId",
      "name": "string",
      "email": "string",
      "role": "string",
      "dept": "string",
      "status": "string"
