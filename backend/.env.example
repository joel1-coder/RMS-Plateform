PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/rms_platform
MONGO_URI_TEST=mongodb://127.0.0.1:27017/rms_platform_test
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20
ALLOWED_FILE_EXTENSIONS=.pdf,.doc,.docx

# Optional S3-compatible storage placeholders.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
